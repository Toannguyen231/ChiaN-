# ChiaNè API Environment Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite for local dev; switch Prisma provider to postgresql + postgres URL for production)
DATABASE_URL="file:./dev.db"

# JWT Signing (minimum 32 characters; generate a strong secret in production)
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-strong-random-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# OTP Configuration
OTP_PROVIDER="console"
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Must be false in production (server refuses startup if NODE_ENV=production and OTP_DEV_ECHO=true)
OTP_DEV_ECHO=true

# Mobile (Expo)
EXPO_PUBLIC_API_URL="http://10.0.2.2:3001"

# Dedicated Google Play review account (both settings required)
REVIEWER_DEMO_PHONE=
REVIEWER_DEMO_OTP=

# Receipt object storage (region defaults to us-east-1; use auto for R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=
