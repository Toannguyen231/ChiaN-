PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-strong-random-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
OTP_PROVIDER="console"
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=true
# Optional: Google Gemini API key for live AI receipt scanning (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
