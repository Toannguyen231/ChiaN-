PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# SQLite (Local Dev): "file:./dev.db" | PostgreSQL (Production - use schema.postgres.prisma):
# DATABASE_URL="postgresql://user:password@host:5432/chiane?sslmode=require"
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-strong-random-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# OTP_PROVIDER: "console" (local dev) | "esms" (eSMS.vn SMS) | "zalo_zns" (Zalo ZNS OA)
OTP_PROVIDER="console"
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=true
# Optional: Google Gemini API key for live AI receipt scanning (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
# Optional: eSMS.vn SMS OTP credentials (when OTP_PROVIDER="esms")
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_BRANDNAME="ChiaNe"
# Optional: Zalo OA ZNS OTP credentials (when OTP_PROVIDER="zalo_zns")
ZALO_ZNS_ACCESS_TOKEN=""
ZALO_ZNS_TEMPLATE_ID=""

# Dedicated Google Play review account (both settings required)
REVIEWER_DEMO_PHONE=
REVIEWER_DEMO_OTP=

# Receipt object storage (region defaults to us-east-1; use auto for R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=

# Android App Links. Render provides RENDER_EXTERNAL_URL automatically.
PUBLIC_APP_ORIGIN=
ANDROID_APP_SHA256=
