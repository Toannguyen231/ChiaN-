{
  "expo": {
    "name": "ChiaNè",
    "slug": "chiane",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chiane",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.chiane.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#173E32"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.chiane.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ChiaNè cần quyền truy cập máy ảnh để chụp và quét hóa đơn chi tiêu.",
        "NSPhotoLibraryUsageDescription": "ChiaNè cần quyền truy cập thư viện ảnh để đính kèm hóa đơn chi tiêu."
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173E32",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "ChiaNè cần quyền truy cập thư viện ảnh để đính kèm hóa đơn chi tiêu.",
          "cameraPermission": "ChiaNè cần quyền truy cập máy ảnh để chụp và quét hóa đơn chi tiêu."
        }
      ],
      "expo-sharing"
    ]
  }
}
